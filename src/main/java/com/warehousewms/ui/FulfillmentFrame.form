<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.warehousewms.ui.FulfillmentFrame">
  <grid id="root" binding="rootPanel" default-binding="true" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="850" height="530"/>
    </constraints>
    <properties>
      <preferredSize width="850" height="530"/>
      <minimumSize width="700" height="460"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="main" binding="mainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="6">
        <margin top="16" left="20" bottom="8" right="20"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="ttl" class="javax.swing.JLabel" binding="titleLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="22" style="1"/>
              <text value="&#x23F1;  Fulfillment &amp; Picking"/>
            </properties>
          </component>
          <grid id="tb" binding="toolbarPanel" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="-1">
            <margin top="4" left="0" bottom="4" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="orderF" class="javax.swing.JTextField" binding="orderIdField">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="120" height="36"/>
                  </grid>
                </constraints>
                <properties><toolTipText value="Order Id"/></properties>
              </component>
              <component id="createB" class="javax.swing.JButton" binding="createRunButton">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="36"/>
                  </grid>
                </constraints>
                <properties><text value="Create Pick Run"/></properties>
              </component>
              <component id="prF" class="javax.swing.JTextField" binding="pickRunIdField">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="120" height="36"/>
                  </grid>
                </constraints>
                <properties><toolTipText value="Pick Run Id"/></properties>
              </component>
              <component id="pickB" class="javax.swing.JButton" binding="completePickButton">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="36"/>
                  </grid>
                </constraints>
                <properties><text value="Complete Pick Run"/></properties>
              </component>
              <hspacer id="hs">
                <constraints>
                  <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
            </children>
          </grid>
          <scrollpane id="sp" binding="tableScrollPane">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="tbl" class="javax.swing.JTable" binding="pickTable">
                <properties/>
              </component>
            </children>
          </scrollpane>
          <component id="st" class="javax.swing.JLabel" binding="statusLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="12"/>
              <text value=" "/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
