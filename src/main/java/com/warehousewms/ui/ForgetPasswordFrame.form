<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.warehousewms.ui.ForgetPasswordFrame">
  <grid id="27dc6" binding="rootPanel" default-binding="true" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="500"/>
    </constraints>
    <properties>
      <preferredSize width="500" height="500"/>
      <minimumSize width="450" height="450"/>
    </properties>
    <border type="none"/>
    <children>
      <!-- Main card-like panel -->
      <grid id="forgotMainPanel" binding="mainPanel" layout-manager="GridLayoutManager" row-count="9" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="10">
        <margin top="40" left="50" bottom="40" right="50"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <!-- App icon placeholder -->
          <component id="forgotIcon" class="javax.swing.JLabel" binding="appIconLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="36"/>
              <horizontalAlignment value="0"/>
              <text value="📦"/>
              <toolTipText value="Smart WMS"/>
            </properties>
          </component>
          <!-- Title -->
          <component id="forgotTitle" class="javax.swing.JLabel" binding="titleLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="28" style="1"/>
              <horizontalAlignment value="0"/>
              <text value="Smart WMS"/>
            </properties>
          </component>
          <!-- Subtitle -->
          <component id="forgotSubtitle" class="javax.swing.JLabel" binding="subtitleLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="14" style="0"/>
              <foreground color="-6710887"/>
              <horizontalAlignment value="0"/>
              <text value="Reset your password"/>
            </properties>
          </component>
          <!-- Spacer -->
          <vspacer id="forgotSpacer">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="5"/>
              </grid>
            </constraints>
          </vspacer>
          <!-- Username or Email label -->
          <component id="forgotUsernameLabel" class="javax.swing.JLabel" binding="usernameOrEmailLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Username or Email"/>
            </properties>
          </component>
          <!-- Username or Email field -->
          <component id="forgotUsernameField" class="javax.swing.JTextField" binding="usernameOrEmailField">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="300" height="36"/>
                <minimum-size width="200" height="36"/>
              </grid>
            </constraints>
            <properties>
              <toolTipText value="Enter your username or email"/>
            </properties>
          </component>
          <!-- Send Reset Link button -->
          <component id="forgotResetButton" class="javax.swing.JButton" binding="resetButton">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="300" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Send Reset Link"/>
            </properties>
          </component>
          <!-- Status / error message -->
          <component id="forgotStatusLabel" class="javax.swing.JLabel" binding="statusLabel">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="12" style="0"/>
              <foreground color="-65536"/>
              <horizontalAlignment value="0"/>
              <text value=""/>
            </properties>
          </component>
          <!-- Back to sign in link -->
          <component id="backToLoginLink" class="javax.swing.JLabel" binding="backToLoginLabel">
            <constraints>
              <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <cursor type="12"/>
              <foreground color="-16728065"/>
              <horizontalAlignment value="0"/>
              <text value="Remember your password? Sign in"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>