<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.warehousewms.ui.BinManagementFrame">
  <grid id="root5" binding="rootPanel" default-binding="true" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="800" height="540"/>
    </constraints>
    <properties>
      <minimumSize width="650" height="440"/>
      <preferredSize width="800" height="540"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="main5" binding="mainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="6">
        <margin top="16" left="20" bottom="8" right="20"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="ttl5" class="javax.swing.JLabel" binding="titleLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="22" style="1"/>
              <text value="Bins / Locations"/>
            </properties>
          </component>
          <grid id="tb5" binding="toolbarPanel" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="-1">
            <margin top="4" left="0" bottom="4" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="ab5" class="javax.swing.JButton" binding="addButton">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="36"/>
                  </grid>
                </constraints>
                <properties>
                  <text value="Add Child"/>
                </properties>
              </component>
              <component id="eb5" class="javax.swing.JButton" binding="editButton">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="36"/>
                  </grid>
                </constraints>
                <properties>
                  <text value="Edit"/>
                </properties>
              </component>
              <component id="db5" class="javax.swing.JButton" binding="deleteButton">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="36"/>
                  </grid>
                </constraints>
                <properties>
                  <text value="Delete"/>
                </properties>
              </component>
              <component id="rb5" class="javax.swing.JButton" binding="refreshButton">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="36"/>
                  </grid>
                </constraints>
                <properties>
                  <text value="Refresh"/>
                </properties>
              </component>
              <hspacer id="hs5">
                <constraints>
                  <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
            </children>
          </grid>
          <scrollpane id="sp5" binding="treeScrollPane">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="tr5" class="javax.swing.JTree" binding="binTree">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
          <component id="st5" class="javax.swing.JLabel" binding="statusLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="12"/>
              <text value=" "/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
